# Copy to .env for local work. On Railway, set these as service variables instead.

# Postgres. Leave empty locally to use a file database in ./.data (development only).
DATABASE_URL=

# First admin account. Used only when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Web server
PORT=3000
NODE_ENV=development

# Kill switch for anything that writes to or spends on an outside system
# (Close, VICIdial, Apify, email finders). Nothing in this build does that yet.
EXTERNAL_WRITES_ENABLED=false

# true = the person who approves an export or a delete must not be the person who asked for it.
# TODO: confirm with James / Ericah (briefing open question 12).
APPROVALS_REQUIRE_SECOND_PERSON=false

# Octoparse, read-only: lists tasks and reads the rows they already collected. Made in the
# Octoparse account center. Leave empty and the app only takes uploaded CSV files.
OCTOPARSE_API_KEY=

# Upload limits
MAX_UPLOAD_MB=25
MAX_IMPORT_ROWS=100000
